<?xml version="1.0" encoding="utf-8"?>
<!--
  Design tokens: TEXT APPEARANCES & WIDGET STYLES.
  Built only from tokens in tokens_colors.xml / tokens_dimens.xml.
  Font family is the platform default (Roboto) via sans-serif / sans-serif-medium.
-->
<resources>

    <!-- ===================== TYPOGRAPHY ===================== -->
    <style name="Text" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/color_foreground</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Subtitle">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Body" />

    <style name="Text.Body.Secondary">
        <item name="android:textColor">@color/color_foreground_secondary</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/color_foreground_secondary</item>
    </style>

    <style name="Text.Caption.Muted">
        <item name="android:textColor">@color/color_foreground_muted</item>
    </style>

    <style name="Text.Overline">
        <item name="android:textSize">@dimen/text_overline</item>
        <item name="android:textColor">@color/color_foreground_muted</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Variants on brand / on image -->
    <style name="Text.Body.Primary">
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="Text.Caption.Primary">
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="Text.Body.Inverse">
        <item name="android:textColor">@color/color_foreground_inverse</item>
    </style>

    <style name="Text.Caption.Inverse">
        <item name="android:textColor">@color/color_foreground_inverse</item>
    </style>

    <style name="Text.Caption.OnImage">
        <item name="android:textColor">@color/color_overlay_light</item>
    </style>

    <!-- ===================== BUTTONS ===================== -->
    <style name="Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:paddingLeft">@dimen/button_padding_x</item>
        <item name="android:paddingRight">@dimen/button_padding_x</item>
        <item name="android:textSize">@dimen/button_font_size</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_fg</item>
    </style>

    <style name="Button.Outline">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/button_outline_fg</item>
    </style>

    <style name="Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/button_danger_fg</item>
    </style>

    <style name="Button.Text">
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="Button.Small">
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:paddingLeft">@dimen/space_3</item>
        <item name="android:paddingRight">@dimen/space_3</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- ===================== INPUTS ===================== -->
    <style name="Input" parent="Widget.AppCompat.EditText">
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingLeft">@dimen/input_padding_x</item>
        <item name="android:paddingRight">@dimen/input_padding_x</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/input_fg</item>
        <item name="android:textColorHint">@color/input_placeholder</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- ===================== BADGES / CHIPS ===================== -->
    <!-- Booking status pill. Set android:background to the matching bg_booking_* drawable. -->
    <style name="Badge">
        <item name="android:minHeight">@dimen/badge_height</item>
        <item name="android:paddingLeft">@dimen/badge_padding_x</item>
        <item name="android:paddingRight">@dimen/badge_padding_x</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/badge_font_size</item>
        <item name="android:textColor">@color/badge_fg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Price-range filter chip (PriceEnum). Use with bg_chip selector. -->
    <style name="Chip">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:paddingLeft">@dimen/chip_padding_x</item>
        <item name="android:paddingRight">@dimen/chip_padding_x</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/selector_chip_fg</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ===================== CONTAINERS ===================== -->
    <style name="Card" parent="CardView">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_thickness</item>
        <item name="android:background">@color/divider_color</item>
    </style>

    <style name="Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="android:background">@color/toolbar_bg</item>
        <item name="titleTextColor">@color/toolbar_fg</item>
        <item name="titleTextAppearance">@style/Text.Title</item>
    </style>

</resources>
