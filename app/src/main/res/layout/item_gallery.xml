<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_default"
    android:background="@color/gray_transfer"
    android:orientation="vertical"
    android:paddingTop="@dimen/margin_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/margin_small"
        android:layout_marginRight="@dimen/margin_small"
        android:orientation="horizontal">
        <!--avartar-->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/avatar"
            android:layout_width="@dimen/avatar_small_size"
            android:layout_height="@dimen/avatar_small_size"
            android:src="@color/gray_light" />
        <!--UserName-->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/margin_default">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_default"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_name"
                android:layout_marginTop="@dimen/padding_tiny"
                android:textColor="@color/white_transfer"
                android:textSize="@dimen/text_size_tiny" />

            <TextView
                android:id="@+id/tv_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_name"
                android:layout_marginLeft="@dimen/margin_default"
                android:layout_marginTop="@dimen/padding_tiny"
                android:layout_toRightOf="@+id/tv_count"
                android:drawableLeft="@drawable/ic_location_white_trans_15dp"
                android:drawablePadding="@dimen/margin_tiny"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/white_transfer"
                android:textSize="@dimen/text_size_tiny" />

        </RelativeLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_default"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_small" />

    <com.paditech.mvpbase.common.view.AutoTopImageLayout
        android:id="@+id/auto_image_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>