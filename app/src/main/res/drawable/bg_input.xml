<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/input_bg" />
            <stroke android:width="@dimen/stroke_thick" android:color="@color/input_border_focus" />
            <corners android:radius="@dimen/input_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/input_bg" />
            <stroke android:width="@dimen/stroke_thin" android:color="@color/input_border" />
            <corners android:radius="@dimen/input_radius" />
        </shape>
    </item>
</selector>
