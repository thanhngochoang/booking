{
  // Chạy và debug app_flutter trên thiết bị đang chọn: điện thoại (USB/Wi-Fi), AVD hoặc Genymotion.
  // Danh sách thiết bị đang kết nối: bấm tên thiết bị ở thanh trạng thái (góc phải dưới) hoặc
  // Cmd+Shift+P > "Flutter: Select Device". F5 tự hiện danh sách nếu chưa chọn thiết bị hợp lệ.
  // Không cấu hình nào cố định deviceId, nên máy nào cũng dùng được như nhau.
  // customTool chạy flutter qua scripts/bin/flutter để dùng SDK, HOME, khoá ký debug và .env của repo.
  "version": "0.2.0",
  "configurations": [
    {
      // Backend: Firebase dev (cloud).
      "name": "Flutter: thiết bị đang chọn",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app_flutter",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "customTool": "${workspaceFolder}/scripts/bin/flutter",
      "customToolReplacesArgs": 0
    },
    {
      // Backend local: chạy scripts/backend-local.sh trước (không cần --lan). preLaunchTask bật
      // adb reverse cho mọi thiết bị, nên EMULATOR_HOST=127.0.0.1 đúng cho AVD, Genymotion và điện thoại.
      "name": "Flutter: thiết bị đang chọn + backend local",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app_flutter",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "preLaunchTask": "adb-reverse-backend",
      "toolArgs": ["--dart-define=USE_EMULATORS=true", "--dart-define=EMULATOR_HOST=127.0.0.1"],
      "customTool": "${workspaceFolder}/scripts/bin/flutter",
      "customToolReplacesArgs": 0
    },
    {
      "name": "Flutter: thiết bị đang chọn (profile)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app_flutter",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "customTool": "${workspaceFolder}/scripts/bin/flutter",
      "customToolReplacesArgs": 0
    }
  ]
}
