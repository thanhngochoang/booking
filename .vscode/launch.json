{
  // Debug app_flutter trên thiết bị thật (USB, bật USB debugging).
  // Chọn thiết bị ở thanh trạng thái VS Code (góc phải dưới) rồi nhấn F5.
  // customTool chạy flutter qua scripts/bin/flutter để dùng SDK, HOME, truststore
  // và .env của project thay vì cấu hình của máy.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter: (debug)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app_flutter",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "customTool": "${workspaceFolder}/scripts/bin/flutter",
      "customToolReplacesArgs": 0
    },
    {
      "name": "Flutter: (profile)",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/app_flutter",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "customTool": "${workspaceFolder}/scripts/bin/flutter",
      "customToolReplacesArgs": 0
    },
    {
      "type": "java",
      "name": "Current File",
      "request": "launch",
      "mainClass": "${file}"
    }
  ]
}
