# Copy to .env (gitignored) and fill in. Never commit real values.
# scripts/env.sh and scripts/bin/{flutter,dart} load this file; Gradle also reads it directly.

# Google Places / Maps key for the legacy Java app (restrict it to Places API + the Android app).
GOOGLE_PLACES_API_KEY=

# Meta developer console > Settings > Advanced > Client token (both apps).
FACEBOOK_CLIENT_TOKEN=

# Optional: Firebase config as base64, written to disk by scripts/env.sh when the file is missing.
#   base64 -i app/google-services.json | tr -d '\n'
APP_GOOGLE_SERVICES_JSON_B64=
FLUTTER_GOOGLE_SERVICES_JSON_B64=
