rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Keys a create may contain / an update may change. Everything else
    // (counters, stats, prices, verification) is written only by Cloud Functions.
    function onlyKeys(allowed) {
      return resource == null
        ? request.resource.data.keys().hasOnly(allowed)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // users/{uid}.avatarPath: the storage key of the user's own uploaded
    // avatar, so the previous file can be deleted (data-model §2.6).
    function validAvatar(uid) {
      let d = request.resource.data;
      return !('avatarPath' in d)
        || (d.avatarPath is string
            && d.avatarPath.matches('^avatars/' + uid + '/[0-9A-HJKMNP-TV-Z]{26}[.]jpg$'));
    }

    function validRole() {
      return !('role' in request.resource.data)
        || request.resource.data.role == null
        || request.resource.data.role in ['customer', 'photographer'];
    }

    // verified / verifiedAt are set only by admins (Cloud Functions / console).
    // A client may create its own doc with verified == false, and never change it afterwards.
    function verifiedUntouched() {
      return resource == null
        ? (!('verified' in request.resource.data) || request.resource.data.verified == false)
            && !('verifiedAt' in request.resource.data)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'verifiedAt']);
    }

    // getAfter: role selection writes users/{uid}.role and photographers/{uid} in one batch.
    function hasPhotographerRole(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.get('role', null) == 'photographer';
    }

    // Fields of users/{uid} a client may write. No email (any signed-in user can read
    // this doc) and no server counters (followerCount, followingCount, savedCount…).
    function userClientFields() {
      return ['displayName', 'avatarUrl', 'avatarPath', 'role', 'createdAt', 'updatedAt'];
    }

    // Fields of photographers/{uid} a client may write. stats.*, startingPrice and
    // verifiedAt are server-computed; verified is allowed only as false on create.
    function photographerClientFields() {
      return ['bio', 'specialties', 'styles', 'equipment', 'yearsExperience', 'serviceArea',
              'contactChannels', 'portfolio', 'skills', 'onboardingComplete', 'verified',
              'createdAt', 'updatedAt'];
    }

    // ---- photographers/{uid}.skills (spec 3e.2–3e.3) ----
    // Catalogue ids, mirrored from lib/data/taxonomy/builtin_taxonomy.dart; the Dart test
    // test/data/skills/rules_catalogue_sync_test.dart keeps both lists equal.
    function skillSpecialtyIds() {
      return ['portrait', 'wedding', 'couple', 'family', 'graduation', 'event', 'product',
              'travel', 'fashion', 'food', 'real_estate', 'newborn', 'street', 'commercial'];
    }
    function skillStyleIds() { return ['natural_light', 'film', 'minimal', 'editorial', 'documentary']; }
    function skillExtraIds() {
      return ['retouch', 'posing', 'video', 'drone', 'studio', 'kids', 'pets', 'low_light', 'outdoor'];
    }
    function skillLanguageIds() { return ['vi', 'en', 'zh', 'ko', 'ja']; }
    function skillAudienceIds() { return ['couple', 'family_kids', 'business', 'foreigner', 'shy_subjects']; }

    // Cost matters: a request may evaluate at most 1000 expressions (every name, literal, call
    // and operator counts), so each catalogue list is built once and passed in, and per-genre
    // work is folded into one regex over a joined string.
    // A non-list value fails on toSet() (an evaluation error denies the write).
    function uniqueTags(xs, allowed, maxSize) {
      return xs.size() <= maxSize && xs.toSet().size() == xs.size() && xs.hasOnly(allowed);
    }
    // One genre as "level:years:count:evidence" ('n' when years is absent), or '!' when its keys,
    // types or evidence uniqueness are wrong. gk is the allowed key list, built once by the caller.
    // The regex requires exactly `count` ids of [A-Za-z0-9_-]{1,64} joined by ',', so an id holding
    // ',', '|', ':' or nothing cannot fake extra, fewer or empty entries.
    // join() turns numbers and bools into text, so the split-back must give the same strings.
    function genreSig(s, gk) {
      let ev = s.get('evidencePostIds', []);
      let joined = ev.join(',');
      return s.keys().hasOnly(gk) && s.level is int && s.get('years', 0) is int
          && ev.toSet().size() == ev.size() && ev.removeAll(joined.split(',')).size() == 0
        ? string(s.level) + ':' + string(s.get('years', 'n')) + ':' + string(ev.size()) + ':' + joined
        : '!';
    }
    // Every genre signature followed by '|'. Accepts levels 1–2 with 0–3 post ids and level 3 with
    // 1–3 post ids, at most three level-3 genres, years 0–50 or absent.
    function genreSigsRe() {
      return '^([12]:(n|[0-9]|[1-4][0-9]|50):(0:|1:[A-Za-z0-9_-]{1,64}|2:[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64}|3:[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64})\\|)*'
        + '(3:(n|[0-9]|[1-4][0-9]|50):(1:[A-Za-z0-9_-]{1,64}|2:[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64}|3:[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64})\\|'
        + '([12]:(n|[0-9]|[1-4][0-9]|50):(0:|1:[A-Za-z0-9_-]{1,64}|2:[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64}|3:[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64},[A-Za-z0-9_-]{1,64})\\|)*){0,3}$';
    }
    // Rules cannot loop: lists of 1–6 genres are expanded by size (largest first, the costliest).
    function genreSigs(sp, gk) {
      return sp.size() == 6
          ? [genreSig(sp[0], gk), genreSig(sp[1], gk), genreSig(sp[2], gk),
             genreSig(sp[3], gk), genreSig(sp[4], gk), genreSig(sp[5], gk)]
        : sp.size() == 5
          ? [genreSig(sp[0], gk), genreSig(sp[1], gk), genreSig(sp[2], gk),
             genreSig(sp[3], gk), genreSig(sp[4], gk)]
        : sp.size() == 4
          ? [genreSig(sp[0], gk), genreSig(sp[1], gk), genreSig(sp[2], gk), genreSig(sp[3], gk)]
        : sp.size() == 3 ? [genreSig(sp[0], gk), genreSig(sp[1], gk), genreSig(sp[2], gk)]
        : sp.size() == 2 ? [genreSig(sp[0], gk), genreSig(sp[1], gk)]
        : [genreSig(sp[0], gk)];
    }
    function genreIds(sp) {
      return sp.size() == 6 ? [sp[0].id, sp[1].id, sp[2].id, sp[3].id, sp[4].id, sp[5].id]
        : sp.size() == 5 ? [sp[0].id, sp[1].id, sp[2].id, sp[3].id, sp[4].id]
        : sp.size() == 4 ? [sp[0].id, sp[1].id, sp[2].id, sp[3].id]
        : sp.size() == 3 ? [sp[0].id, sp[1].id, sp[2].id]
        : sp.size() == 2 ? [sp[0].id, sp[1].id]
        : [sp[0].id];
    }
    // 1–6 genres with unique catalogue ids; each genre's shape via genreSig + genreSigsRe.
    function validSpecialties(sp, ids) {
      let gid = sp.size() >= 1 && sp.size() <= 6 ? genreIds(sp) : ['!'];
      return gid.hasOnly(ids) && gid.toSet().size() == sp.size()
        && (genreSigs(sp, ['id', 'level', 'years', 'evidencePostIds']).join('|') + '|')
             .matches(genreSigsRe());
    }
    // k: the skills map after the write (post-merge for set(merge: true), so it still holds the
    // stored server fields); before: the stored skills map ({} on create).
    // skills.completeness, completenessNext, completenessNextAfter, updatedAt and evidenceRemovedAt
    // are written by the Cloud Function onPhotographerWrite only: each must equal the stored value,
    // and be absent (not even null) when none is stored. The extra names add a handful of list
    // entries to a request, far inside the 1000-expression budget (rules test "expression budget ..."
    // pins the largest save).
    function validSkills(k, before) {
      return k is map
        && k.keys().hasOnly(['schemaVersion', 'specialties', 'styles', 'extras', 'languages',
                             'audiences', 'yearsExperience', 'completeness', 'completenessNext',
                             'completenessNextAfter', 'updatedAt', 'evidenceRemovedAt'])
        && k.get('schemaVersion', 0) == 1
        && !k.diff(before).affectedKeys().hasAny(['completeness', 'completenessNext',
                                                  'completenessNextAfter', 'updatedAt',
                                                  'evidenceRemovedAt'])
        && uniqueTags(k.get('styles', []), skillStyleIds(), 4)
        && uniqueTags(k.get('extras', []), skillExtraIds(), 8)
        && uniqueTags(k.get('audiences', []), skillAudienceIds(), 4)
        && uniqueTags(k.get('languages', []), skillLanguageIds(), 5)
        && k.get('languages', []).size() >= 1
        && (k.get('yearsExperience', null) == null
            || (k.yearsExperience is int && k.yearsExperience >= 0 && k.yearsExperience <= 50))
        && validSpecialties(k.get('specialties', []), skillSpecialtyIds());
    }
    // Field checks of photographers/{uid}. The changed-key set is computed once, and each field
    // validator runs only when the write sets, changes or removes that field: an unchanged stored
    // value was validated when it was written, and re-checking it on every merge would spend the
    // 1000-expression budget a request may evaluate. Removing skills is refused (validSkills then
    // fails on the missing value).
    function photographerFieldsOk(uid) {
      let changed = resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(photographerClientFields())
        && (!('serviceArea' in changed) || validServiceArea())
        && (!('contactChannels' in changed) || validContactChannels(uid))
        && (!('bio' in changed || 'equipment' in changed) || validIntro())
        && (!('skills' in changed)
            || validSkills(request.resource.data.skills,
                           resource == null ? {} : resource.data.get('skills', {})));
    }

    // photographers/{uid} fields of setup step 1 (S24). Runs only when the write changes bio or
    // equipment (see photographerFieldsOk).
    function validIntro() {
      let d = request.resource.data;
      return (!('bio' in d) || (d.bio is string && d.bio.size() <= 300))
        && (!('equipment' in d) || (d.equipment is list && d.equipment.size() <= 8));
    }

    // photographers/{uid}/services/{id}: whole VND above zero, a duration from
    // the fixed list, no server fields. Packages are hidden (active: false),
    // never deleted, so posts and bookings keep a valid serviceId.
    function validService() {
      let d = request.resource.data;
      let del = d.get('deliverables', {});
      return d.keys().hasOnly(['name', 'specialty', 'price', 'durationMinutes', 'deliverables',
                               'coverUrl', 'active', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.price is int && d.price > 0 && d.price <= 1000000000
        && d.durationMinutes in [60, 120, 180, 240, 360, 480]
        && d.get('active', true) is bool
        && del is map
        && del.keys().hasOnly(['photoCount', 'editedCount', 'deliveryDays'])
        && del.get('photoCount', 0) is int && del.get('photoCount', 0) >= 0 && del.get('photoCount', 0) <= 2000
        && del.get('editedCount', 0) is int && del.get('editedCount', 0) >= 0 && del.get('editedCount', 0) <= 2000
        && del.get('deliveryDays', 0) is int && del.get('deliveryDays', 0) >= 0 && del.get('deliveryDays', 0) <= 90;
    }

    // serviceArea: a city and a whole-number radius in km (centre point added with the location work).
    function validServiceArea() {
      let d = request.resource.data;
      return !('serviceArea' in d)
        || (d.serviceArea is map
            && d.serviceArea.keys().hasOnly(['city', 'radiusKm', 'center'])
            && d.serviceArea.city is string
            && d.serviceArea.city.size() >= 2 && d.serviceArea.city.size() <= 80
            && d.serviceArea.radiusKm is int
            && d.serviceArea.radiusKm >= 1 && d.serviceArea.radiusKm <= 200
            && (!('center' in d.serviceArea) || d.serviceArea.center is latlng));
    }

    // contactChannels: public on/off flags only, never a number. A channel can be on only if the
    // private contact doc exists once this write (or batch) is applied.
    function validContactChannels(uid) {
      let d = request.resource.data;
      return !('contactChannels' in d)
        || (d.contactChannels is map
            && d.contactChannels.keys().hasOnly(['call', 'zalo', 'whatsapp', 'acceptInquiries'])
            && d.contactChannels.get('call', false) is bool
            && d.contactChannels.get('zalo', false) is bool
            && d.contactChannels.get('whatsapp', false) is bool
            && d.contactChannels.get('acceptInquiries', true) is bool
            && (!(d.contactChannels.get('call', false)
                  || d.contactChannels.get('zalo', false)
                  || d.contactChannels.get('whatsapp', false))
                || existsAfter(/databases/$(database)/documents/photographers/$(uid)/private/contact)));
    }

    // photographers/{uid}/private/contact: the photographer's real numbers. Owner-only; a customer
    // only ever gets a server-built link (callable getContactLink). Vietnamese E.164 for phone and
    // Zalo, "+country digits" for WhatsApp.
    function validPhotographerNumbers() {
      let d = request.resource.data;
      return d.keys().hasOnly(['phone', 'zaloPhone', 'whatsappPhone', 'updatedAt'])
        && d.phone is string
        && d.phone.matches('^\\+84[35789][0-9]{8}$')
        && (!('updatedAt' in d) || d.updatedAt == request.time)
        && (!('zaloPhone' in d)
            || (d.zaloPhone is string && d.zaloPhone.matches('^\\+84[35789][0-9]{8}$')))
        && (!('whatsappPhone' in d)
            || (d.whatsappPhone is string && d.whatsappPhone.matches('^\\+[0-9]{8,15}$')));
    }

    // users/{uid}/private/contact: owner-only; E.164 Vietnamese number; the
    // verified flag is never changed by a client (verification comes later).
    function validContact(uid) {
      let d = request.resource.data;
      let old = resource == null ? null : resource.data;
      return d.keys().hasOnly(['phone', 'phoneVerified', 'allowZalo', 'allowWhatsApp', 'updatedAt'])
        && d.phone is string
        && d.phone.matches('^\\+84[35789][0-9]{8}$')
        && (!('updatedAt' in d) || d.updatedAt == request.time)
        && ((old != null && d.phone != old.phone)
            ? d.get('phoneVerified', false) == false
            : d.get('phoneVerified', false) == (old == null ? false : old.get('phoneVerified', false)))
        && d.get('allowZalo', true) is bool
        && d.get('allowWhatsApp', false) is bool;
    }

    // likes/saves/follows: markers named {uid}_{targetId}, owned by uid. Reads
    // key off the document id, because a missing document has no `resource`
    // and "not liked yet" must be answerable.
    function markerId(uid, id) { return uid + '_' + id; }
    // The id prefix before the first '_' must be the caller's uid (uids contain
    // no '_', so split is exact; string slicing is not used because the rules
    // language does not guarantee it). A marker is really theirs only when its
    // stored userId says so as well: uid `v1` must not touch `v1_x_post1`,
    // which belongs to uid `v1_x`.
    function ownMarkerName(docId) {
      return signedIn()
        && docId.split('_').size() > 1
        && docId.split('_')[0] == request.auth.uid;
    }
    function ownMarkerDoc() {
      return resource.data.get('userId', null) == request.auth.uid;
    }
    // Markers are written with set() (idempotent): createdAt is the server time
    // of the write, or (on an update) the value already stored.
    function validMarker(docId, targetField) {
      let d = request.resource.data;
      return d.keys().hasOnly(['userId', targetField, 'createdAt'])
        && d.userId == request.auth.uid
        && d[targetField] is string
        && docId == markerId(request.auth.uid, d[targetField])
        && (resource == null || ownMarkerDoc())
        && (d.createdAt == request.time
            || (resource != null && d.createdAt == resource.data.get('createdAt', null)));
    }

    // posts/{id}: a photographer creates a "work" post for themself, with 1 to
    // 10 photos and one of their own active packages. Counters start at zero
    // and the time is the server's. Posts are not edited from the client.
    function validPostCreate() {
      let d = request.resource.data;
      let uid = request.auth.uid;
      return d.keys().hasOnly(['kind', 'authorId', 'photographerId', 'serviceId', 'specialty',
                               'imageUrls', 'imageMeta', 'caption', 'location', 'style',
                               'hashtags', 'inPortfolio', 'likeCount', 'saveCount', 'createdAt'])
        && d.keys().hasAll(['kind', 'authorId', 'photographerId', 'serviceId', 'imageUrls',
                            'caption', 'likeCount', 'saveCount', 'createdAt'])
        && d.kind == 'work'
        && d.authorId == uid
        && d.photographerId == uid
        && hasPhotographerRole(uid)
        && d.serviceId is string
        && get(/databases/$(database)/documents/photographers/$(uid)/services/$(d.serviceId))
             .data.get('active', true) == true
        && d.imageUrls is list && d.imageUrls.size() >= 1 && d.imageUrls.size() <= 10
        && (!('imageMeta' in d) || (d.imageMeta is list && d.imageMeta.size() == d.imageUrls.size()))
        && d.caption is string && d.caption.size() <= 2000
        && (!('hashtags' in d) || (d.hashtags is list && d.hashtags.size() <= 30))
        && (!('inPortfolio' in d) || d.inPortfolio is bool)
        && d.likeCount == 0 && d.saveCount == 0
        && d.createdAt == request.time;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && validRole() && validAvatar(uid) && onlyKeys(userClientFields());
      allow delete: if false;

      match /private/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'contact' && validContact(uid);
        allow delete: if false;
      }
    }

    match /photographers/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && hasPhotographerRole(uid)
        && verifiedUntouched()
        && photographerFieldsOk(uid);
      allow delete: if false;

      match /services/{serviceId} {
        allow read: if signedIn();
        allow create, update: if isOwner(uid) && hasPhotographerRole(uid) && validService();
        allow delete: if false;
      }

      match /private/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && hasPhotographerRole(uid)
          && docId == 'contact'
          && validPhotographerNumbers();
        allow delete: if false;
      }
    }

    function isBookingContactUnlocked(b) {
      return b.status in ['requested', 'accepted', 'upcoming']
        || ((b.status in ['completed', 'reviewed'])
            && ('completedAt' in b)
            && b.completedAt != null
            && request.time <= b.completedAt + duration.value(30, 'd'));
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.photographerId == request.auth.uid);
      allow write: if false; // only Cloud Functions (sub-project 4)

      match /private/{docId} {
        allow read: if signedIn()
          && docId == 'contact'
          && (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid
            || (
              get(/databases/$(database)/documents/bookings/$(bookingId)).data.photographerId == request.auth.uid
              && isBookingContactUnlocked(get(/databases/$(database)/documents/bookings/$(bookingId)).data)
            )
          );
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid
              || get(/databases/$(database)/documents/bookings/$(bookingId)).data.photographerId == request.auth.uid);
        allow write: if false;
      }
    }

    match /payments/{paymentId} {
      allow read, write: if false;
    }

    match /refunds/{refundId} {
      allow read, write: if false;
    }

    match /ledger_entries/{entryId} {
      allow read, write: if false;
    }

    // chats/{chatId}: inquiry and booking conversations.
    // Read: members only.
    // Client write: false (all messages and status updates go through Functions).
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow write: if false;
      }

      match /members/{uid} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unreadCount', 'lastReadAt'])
          && request.resource.data.unreadCount == 0
          && request.resource.data.lastReadAt == request.time;
        allow create, delete: if false;
      }
    }

    // Posts are read by any signed-in user. A photographer creates their own
    // work post (S21); counters are always written by Cloud Functions.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && validPostCreate();
      allow update, delete: if false;
    }

    match /likes/{docId} {
      allow get: if ownMarkerName(docId) && (resource == null || ownMarkerDoc());
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if ownMarkerName(docId) && validMarker(docId, 'postId');
      allow delete: if ownMarkerName(docId) && ownMarkerDoc();
    }
    match /saves/{docId} {
      allow get: if ownMarkerName(docId) && (resource == null || ownMarkerDoc());
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if ownMarkerName(docId) && validMarker(docId, 'postId');
      allow delete: if ownMarkerName(docId) && ownMarkerDoc();
    }
    match /follows/{docId} {
      allow get: if ownMarkerName(docId) && (resource == null || ownMarkerDoc());
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if ownMarkerName(docId) && validMarker(docId, 'photographerId');
      allow delete: if ownMarkerName(docId) && ownMarkerDoc();
    }

    // ContactAccessLog: written only by getContactLink through the Admin SDK (rules do not apply
    // to it). No client may read or write it, not even the requester.
    match /contact_access_log/{logId} {
      allow read, write: if false;
    }

    // availability/{uid}/days/{yyyy-MM-dd}; no document means free. The
    // photographer only marks free days off and frees them again; booked and
    // pending days come from bookings and events (server only).
    match /availability/{uid}/days/{dayKey} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && hasPhotographerRole(uid)
        && dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
        && request.resource.data.state == 'off';
      allow update: if false;
      allow delete: if isOwner(uid) && resource.data.state == 'off';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
