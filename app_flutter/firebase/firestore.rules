rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Keys a create may contain / an update may change. Everything else
    // (counters, stats, prices, verification) is written only by Cloud Functions.
    function onlyKeys(allowed) {
      return resource == null
        ? request.resource.data.keys().hasOnly(allowed)
        : request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function validRole() {
      return !('role' in request.resource.data)
        || request.resource.data.role == null
        || request.resource.data.role in ['customer', 'photographer'];
    }

    // verified / verifiedAt are set only by admins (Cloud Functions / console).
    // A client may create its own doc with verified == false, and never change it afterwards.
    function verifiedUntouched() {
      return resource == null
        ? (!('verified' in request.resource.data) || request.resource.data.verified == false)
            && !('verifiedAt' in request.resource.data)
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'verifiedAt']);
    }

    // getAfter: role selection writes users/{uid}.role and photographers/{uid} in one batch.
    function hasPhotographerRole(uid) {
      return getAfter(/databases/$(database)/documents/users/$(uid)).data.get('role', null) == 'photographer';
    }

    // Fields of users/{uid} a client may write. No email (any signed-in user can read
    // this doc) and no server counters (followerCount, followingCount, savedCount…).
    function userClientFields() {
      return ['displayName', 'avatarUrl', 'role', 'createdAt', 'updatedAt'];
    }

    // Fields of photographers/{uid} a client may write. stats.*, startingPrice and
    // verifiedAt are server-computed; verified is allowed only as false on create.
    function photographerClientFields() {
      return ['bio', 'specialties', 'styles', 'equipment', 'yearsExperience', 'serviceArea',
              'portfolio', 'onboardingComplete', 'verified', 'createdAt', 'updatedAt'];
    }

    // users/{uid}/private/contact: owner-only; E.164 Vietnamese number; the
    // verified flag is never changed by a client (verification comes later).
    function validContact(uid) {
      let d = request.resource.data;
      let old = resource == null ? null : resource.data;
      return d.keys().hasOnly(['phone', 'phoneVerified', 'allowZalo', 'allowWhatsApp', 'updatedAt'])
        && d.phone is string
        && d.phone.matches('^\\+84[35789][0-9]{8}$')
        && d.get('phoneVerified', false) == (old == null ? false : old.get('phoneVerified', false))
        && d.get('allowZalo', true) is bool
        && d.get('allowWhatsApp', false) is bool;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) && validRole() && onlyKeys(userClientFields());
      allow delete: if false;

      match /private/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && docId == 'contact' && validContact(uid);
        allow delete: if false;
      }
    }

    match /photographers/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && hasPhotographerRole(uid)
        && verifiedUntouched()
        && onlyKeys(photographerClientFields());
      allow delete: if false;

      match /services/{serviceId} {
        allow read: if signedIn();
        allow write: if isOwner(uid) && hasPhotographerRole(uid);
      }
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
            || resource.data.photographerId == request.auth.uid);
      allow write: if false; // only Cloud Functions (sub-project 4)
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
