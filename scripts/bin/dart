#!/usr/bin/env bash
# Runs dart with a project-local HOME so Dart/Flutter/Gradle/Android write only inside the repo (no admin, sandbox-safe).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export HOME="$ROOT/.home" PUB_CACHE="$ROOT/.pub-cache" ANDROID_HOME="$ROOT/.android-sdk" ANDROID_SDK_ROOT="$ROOT/.android-sdk"
export FLUTTER_SUPPRESS_ANALYTICS=true
[ -n "${JAVA_HOME:-}" ] || export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home

# JVM options for Gradle: corporate TLS truststore, and the sandbox/corporate HTTP proxy from HTTPS_PROXY
# (Java ignores proxy environment variables; Gradle's wrapper and dependency resolver honor these system properties).
JOPTS=""
[ -f "$ROOT/.certs/truststore.jks" ] && JOPTS="-Djavax.net.ssl.trustStore=$ROOT/.certs/truststore.jks -Djavax.net.ssl.trustStorePassword=changeit"
P="${HTTPS_PROXY:-${https_proxy:-}}"
if [ -n "$P" ]; then
  P="${P#*://}"; AUTH=""; HOSTPORT="$P"
  case "$P" in *@*) AUTH="${P%@*}"; HOSTPORT="${P##*@}";; esac
  HOST="${HOSTPORT%%:*}"; [ "$HOST" = localhost ] && HOST=127.0.0.1; PORT="${HOSTPORT##*:}"; PORT="${PORT%%/*}"
  JOPTS="$JOPTS -Dhttp.proxyHost=$HOST -Dhttp.proxyPort=$PORT -Dhttps.proxyHost=$HOST -Dhttps.proxyPort=$PORT -Dhttp.nonProxyHosts=localhost|127.0.0.1 -Djdk.http.auth.tunneling.disabledSchemes= -Djdk.http.auth.proxying.disabledSchemes="
  if [ -n "$AUTH" ]; then
    JOPTS="$JOPTS -Dhttp.proxyUser=${AUTH%%:*} -Dhttp.proxyPassword=${AUTH#*:} -Dhttps.proxyUser=${AUTH%%:*} -Dhttps.proxyPassword=${AUTH#*:}"
  fi
fi
export JAVA_TOOL_OPTIONS="-Djava.net.preferIPv4Stack=true $JOPTS"
exec "$ROOT/.flutter/bin/dart" "$@"
