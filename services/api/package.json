{
  "name": "@nag/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/db/migrate-cli.ts src/tools/seed-contract.ts --bundle --platform=node --target=node22 --format=esm --packages=external --sourcemap --outdir=dist",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed:contract": "tsx src/tools/seed-contract.ts",
    "import:firestore": "tsx tools/firestore-import/cli.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript api/openapi.yaml -o src/generated/api.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "fastify": "^5.12.7",
    "jose": "^5.9.6",
    "kysely": "^0.29.6",
    "node-pg-migrate": "^7.8.0",
    "pg": "^8.13.1",
    "ulidx": "^2.4.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "firebase-admin": "^13.10.0",
    "openapi-typescript": "^7.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid@<11.1.1": "^11.1.1",
    "undici@<6.28.1": "^6.28.1",
    "@fastify/busboy@<3.2.2": "^3.2.2",
    "node-pg-migrate": {
      "glob": "^11.1.0"
    }
  }
}
